{
  "manifest_version": 3,
  "name": "Spotify Time Limiter",
  "version": "1.2.8",
  "description": "Limits the time spent on Spotify (and other music sites) during school hours.",
  "minimum_chrome_version": "111",
  "update_url": "https://raw.githubusercontent.com/YOUR-ORG/YOUR-REPO/main/update.xml",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://*.open.spotify.com/*",
    "https://*.music.youtube.com/*",
    "https://*.music.apple.com/*",
    "https://*.music.amazon.com/*",
    "https://*.music.amazon.ca/*",
    "https://*.pandora.com/*",
    "https://*.soundcloud.com/*",
    "https://*.deezer.com/*",
    "https://*.tidal.com/*",
    "https://*.iheart.com/*",
    "https://*.tunein.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.open.spotify.com/*",
        "https://*.music.youtube.com/*",
        "https://*.music.apple.com/*",
        "https://*.music.amazon.com/*",
        "https://*.music.amazon.ca/*",
        "https://*.pandora.com/*",
        "https://*.soundcloud.com/*",
        "https://*.deezer.com/*",
        "https://*.tidal.com/*",
        "https://*.iheart.com/*",
        "https://*.tunein.com/*"
      ],
      "js": [
        "pip-guard.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.open.spotify.com/*",
        "https://*.music.youtube.com/*",
        "https://*.music.apple.com/*",
        "https://*.music.amazon.com/*",
        "https://*.music.amazon.ca/*",
        "https://*.pandora.com/*",
        "https://*.soundcloud.com/*",
        "https://*.deezer.com/*",
        "https://*.tidal.com/*",
        "https://*.iheart.com/*",
        "https://*.tunein.com/*"
      ],
      "js": [
        "config.js",
        "core.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Spotify time limit",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/idle-16.png",
      "32": "icons/idle-32.png",
      "48": "icons/idle-48.png"
    }
  },
  "icons": {
    "16": "icons/idle-16.png",
    "32": "icons/idle-32.png",
    "48": "icons/idle-48.png",
    "128": "icons/idle-128.png"
  }
}