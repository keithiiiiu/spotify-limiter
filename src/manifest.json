{
  "manifest_version": 3,
  "name": "Spotify Time Limiter",
  "version": "1.3.0",
  "description": "Limits the time spent on Spotify (and other music sites) during school hours.",
  "minimum_chrome_version": "111",
  "update_url": "https://raw.githubusercontent.com/keithiiiiu/spotify-limiter/refs/heads/main/extension/edge.xml",
  "permissions": [
    "storage",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Spotify time limit",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/idle-16.png",
      "32": "icons/idle-32.png",
      "48": "icons/idle-48.png"
    }
  },
  "icons": {
    "16": "icons/idle-16.png",
    "32": "icons/idle-32.png",
    "48": "icons/idle-48.png",
    "128": "icons/idle-128.png"
  }
}